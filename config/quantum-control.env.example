# Public Control API
QUANTUM_CONTROL_LISTEN=127.0.0.1:17440

# Optional legacy bearer token. Required for non-loopback listeners unless an
# actor registry is configured. This token maps to a service identity and never
# receives human confirmation authority.
# QUANTUM_CONTROL_API_TOKEN=replace-with-a-long-random-value

# Optional actor registry with SHA-256 token digests, never raw bearer tokens.
# QUANTUM_CONTROL_ACTOR_FILE=/etc/quantum-control/actors.json

# Durable security state. The systemd package provisions
# /var/lib/quantum-control with mode 0700.
QUANTUM_CONTROL_AUDIT_PATH=/var/lib/quantum-control/audit/audit.jsonl
QUANTUM_CONTROL_GRANT_PATH=/var/lib/quantum-control/security/grants.json
QUANTUM_CONTROL_PLAN_TTL=5m
QUANTUM_CONTROL_GRANT_TTL=2m

# Broker connection
QUANTUM_CONTROL_BROKER_SOCKET=/run/quantum-control/qcored.sock
QUANTUM_CONTROL_BROKER_TOKEN_FILE=/etc/quantum-control/broker.token

# Limits and timeouts
QUANTUM_CONTROL_REQUEST_BODY_LIMIT=1048576
QUANTUM_CONTROL_HEADER_TIMEOUT=10s
QUANTUM_CONTROL_IDLE_TIMEOUT=90s
QUANTUM_CONTROL_BROKER_TIMEOUT=15s
