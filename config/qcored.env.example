# Privileged broker Unix socket
QUANTUM_CONTROL_BROKER_SOCKET=/run/quantum-control/qcored.sock

# Shared secret generated during installation.
QUANTUM_CONTROL_BROKER_TOKEN_FILE=/etc/quantum-control/broker.token

# Limits and timeouts
QUANTUM_CONTROL_BROKER_REQUEST_BODY_LIMIT=1048576
QUANTUM_CONTROL_BROKER_HEADER_TIMEOUT=10s
QUANTUM_CONTROL_BROKER_IDLE_TIMEOUT=30s
